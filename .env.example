# Copy to .env (never commit it) or set these in Vercel → Project → Settings → Environment Variables.
# All are optional; without them the app runs locally with mail in an outbox file.

# Where links in emails point
APP_URL=https://your-app.vercel.app

# Web Push (generate with: node backend/webpush.js keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# Email: pick one provider. MAIL_FROM must be a sender the provider has verified.
MAIL_FROM=LuminAAC <no-reply@your-domain.org>
# MAIL_MODE=resend | postmark | smtp | outbox | console   (auto-detected if unset)
RESEND_API_KEY=
POSTMARK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Weekly care-team summary: secret for the Vercel cron call to /api/cron/weekly
CRON_SECRET=

# Hosted storage (Upstash Redis via the Vercel marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional
YOUTUBE_API_KEY=
ALLOWED_ORIGINS=*
